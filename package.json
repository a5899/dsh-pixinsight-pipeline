{
  "name": "dsh-pixinsight-pipeline",
  "version": "0.7.0",
  "description": "DSH plugin that bundles the pixinsight-pipeline skill and its file-based IPC bridge: drive PixInsight 1.9.4 from DeepSeek Harness to process deep-sky astrophotography (HaRGB / HaLRGB / LRGB / RGB) and auto-run WBPP. · 把 PixInsight 深空后期全流程做成 DSH 插件：技能 + 桥接 CLI + PJSR watcher + WBPP 自动化。",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "skills",
    "scripts",
    "cordis.patch.yml",
    "CHANGELOG.md",
    "README.md",
    "AGENTS.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "skill",
    "pixinsight",
    "astrophotography",
    "deep-sky",
    "astro",
    "wbpp",
    "pjsr",
    "stretch",
    "narrowband"
  ],
  "engines": {
    "node": ">=20"
  },
  "os": [
    "win32",
    "darwin",
    "linux"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/a5899/dsh-pixinsight-pipeline.git"
  },
  "homepage": "https://github.com/a5899/dsh-pixinsight-pipeline",
  "bugs": {
    "url": "https://github.com/a5899/dsh-pixinsight-pipeline/issues"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-skill": ">=0.1.1-rc.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-skill": {
      "optional": true
    }
  },
  "scripts": {
    "test": "node test/contract.mjs && node test/smoke.mjs && node test/syntax.mjs && node test/scripts.mjs && node scripts/sync-skill.mjs --check",
    "test:skill-sync": "node scripts/sync-skill.mjs --check",
    "wbpp:find-masters": "node lib/pixinsight-mcp/scripts/find-masters.mjs",
    "wbpp:clean": "node lib/pixinsight-mcp/scripts/clean-wbpp-intermediates.mjs",
    "toolkit": "node lib/pixinsight-mcp/scripts/resolve-toolkit.mjs",
    "gaia:check": "node lib/pixinsight-mcp/scripts/ensure-gaia.mjs"
  }
}
